<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UIDoc/Stylesheet.uss?fileID=7433441132597879392&amp;guid=51bb85bde2cbe894e9dc2cb680bff215&amp;type=3#Stylesheet" />
    <ui:VisualElement name="ROOT" style="flex-grow: 1; flex-direction: column;">
        <ui:VisualElement name="bossInfo" style="flex-grow: 1;">
            <ui:VisualElement name="hpBase" class="visualElement" style="align-self: flex-end; justify-content: center; background-color: rgb(164, 166, 173); border-top-left-radius: 13px; border-top-right-radius: 13px; border-bottom-right-radius: 13px; border-bottom-left-radius: 13px; height: 15%; color: rgb(152, 155, 159); margin-top: 9px; margin-right: 9px; margin-bottom: 9px; margin-left: 9px; width: 56%;">
                <ui:VisualElement name="HpFillEnemy" class="visualElement" style="align-self: flex-start; justify-content: center; background-color: rgb(130, 45, 21); border-top-left-radius: 13px; border-top-right-radius: 13px; border-bottom-right-radius: 13px; border-bottom-left-radius: 13px; height: 100%; width: 100%; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(91, 19, 19); border-right-color: rgb(91, 19, 19); border-top-color: rgb(91, 19, 19); border-bottom-color: rgb(91, 19, 19);" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="playerStats" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0); padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; flex-direction: row;">
            <ui:VisualElement name="hpBase" class="visualElement" style="align-self: flex-end; justify-content: center; background-color: rgb(164, 166, 173); border-top-left-radius: 13px; border-top-right-radius: 13px; border-bottom-right-radius: 13px; border-bottom-left-radius: 13px; height: 15%; color: rgb(152, 155, 159); margin-top: 9px; margin-right: 9px; margin-bottom: 9px; margin-left: 9px; width: 56%;">
                <ui:VisualElement name="HpFillPlayer" class="visualElement" style="align-self: flex-start; justify-content: center; background-color: rgb(130, 45, 21); border-top-left-radius: 13px; border-top-right-radius: 13px; border-bottom-right-radius: 13px; border-bottom-left-radius: 13px; height: 100%; width: 100%; border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-left-color: rgb(91, 19, 19); border-right-color: rgb(91, 19, 19); border-top-color: rgb(91, 19, 19); border-bottom-color: rgb(91, 19, 19);" />
